Screen {
    background: $surface;
}

#header {
    dock: top;
    height: 1;
    background: $primary;
    color: $text;
    text-align: center;
}

#chat-panel {
    height: 1fr;
    border: solid $primary;
    overflow-y: auto;
    padding: 0 1;
}

#command-log {
    height: auto;
    max-height: 8;
    border: solid $secondary;
    overflow-y: auto;
    padding: 0 1;
}

#input-bar {
    dock: bottom;
    height: 3;
    padding: 0 1;
}

#status-bar {
    dock: bottom;
    height: 1;
    background: $surface-darken-1;
    color: $text-muted;
    padding: 0 1;
}

.message {
    margin: 0 0 1 0;
}

.message-agent {
    color: $success;
}

.message-user {
    color: $primary;
}

.command-entry {
    color: $warning;
}

ApprovalModal {
    align: center middle;
}

#approval-dialog {
    width: 60;
    height: auto;
    max-height: 20;
    border: thick $error;
    background: $surface;
    padding: 1 2;
}

#approval-dialog .title {
    text-align: center;
    text-style: bold;
    color: $error;
    margin-bottom: 1;
}

#approval-command {
    background: $surface-darken-2;
    padding: 1;
    margin: 1 0;
}

#approval-buttons {
    height: 3;
    align: center middle;
}

#approval-buttons Button {
    margin: 0 1;
}
