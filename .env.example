# =============================================================================
# agent-ls Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The app auto-loads .env on startup via python-dotenv.

# -----------------------------------------------------------------------------
# AWS Bedrock Configuration (primary LLM provider)
# -----------------------------------------------------------------------------

# AWS region for Bedrock runtime
AWS_REGION=us-west-2

# Bedrock endpoint (Salesforce internal gateway or AWS direct)
BEDROCK_ENDPOINT_URL=

# Auth token for the Bedrock gateway (if using token-based auth)
BEDROCK_AUTH_TOKEN=

# AWS credentials (alternative to token-based auth)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Bedrock model IDs (defaults shown — override if needed)
BEDROCK_MODEL_CHEAP=anthropic.claude-haiku-4-5-20251001
BEDROCK_MODEL_EXPENSIVE=anthropic.claude-sonnet-4-20250514

# -----------------------------------------------------------------------------
# Anthropic Direct API (optional — not needed if using Bedrock)
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...

# -----------------------------------------------------------------------------
# OpenAI (optional — for GPT-4o-mini fallback routing)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# Slack Integration
# -----------------------------------------------------------------------------

# Slack User OAuth token (required for search & posting)
# Get from: https://api.slack.com/apps → OAuth & Permissions → User Token
# Scopes needed: search:read, chat:write, users:read
SLACK_USER_TOKEN=xoxp-...

# -----------------------------------------------------------------------------
# Obsidian Vault
# -----------------------------------------------------------------------------

# Path to your local Obsidian vault directory
OBSIDIAN_VAULT_PATH=~/Documents/ObsidianVault

# Enable git auto-sync for the vault (true/false)
OBSIDIAN_GIT_AUTO_SYNC=true

# -----------------------------------------------------------------------------
# Ollama (optional — for local model routing)
# -----------------------------------------------------------------------------
# OLLAMA_BASE_URL=http://localhost:11434
